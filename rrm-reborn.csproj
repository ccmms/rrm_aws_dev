<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<TypeScriptTarget>ES2021</TypeScriptTarget>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<TypeScriptTarget>ES2021</TypeScriptTarget>
	</PropertyGroup>
	
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>rrm_reborn</RootNamespace>
    <TypeScriptJSXEmit>preserve</TypeScriptJSXEmit>
  </PropertyGroup>
	
  <ItemGroup>
	  <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.30" />
	  <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.30" />
	  <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="7.0.1">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <TypeScriptCompile Include="frontend\src\components\scene3d.tsx" />
    <TypeScriptCompile Include="frontend\src\components\viewer3d.tsx" />
    <TypeScriptCompile Include="frontend\src\core\geometry\geometry_types.ts" />
    <TypeScriptCompile Include="frontend\src\core\geometry\rendering_types.ts" />
    <TypeScriptCompile Include="frontend\src\rendering\three\overlays\boundingbox_renderer.ts" />
    <TypeScriptCompile Include="frontend\src\rendering\three\camera\camera_controller.ts" />
    <TypeScriptCompile Include="frontend\src\rendering\three\layers\surface_renderer.ts" />
    <TypeScriptCompile Include="frontend\src\api\surface\surface_api_types.ts" />
    <TypeScriptCompile Include="frontend\src\api\surface\surface_api.ts" />
  </ItemGroup>

</Project>
 